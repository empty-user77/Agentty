<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime. Agentty is a terminal: shells and agents it starts are separate,
         independently signed executables, so no JIT or library-validation exceptions are needed.
         osascript is used for notifications (see NSAppleEventsUsageDescription). -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- Microphone access, so an agent's own voice dictation (e.g. Claude Code / Codex `/voice`)
         running in a terminal can record. Under the hardened runtime the host app needs this
         entitlement for macOS to grant the microphone to the processes it starts. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
