# Copy to .env.agentty-prod (gitignored) for signed + notarized builds. See docs/release.md.
AGENTTY_IDENTITY="YOUR NAME (TEAMID1234)"
AGENTTY_TEAM_ID="TEAMID1234"
AGENTTY_APPLE_ID="you@example.com"
AGENTTY_APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"
# Google Analytics 4 (Measurement Protocol) — compiled into release builds; leave empty to send nothing.
AGENTTY_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
AGENTTY_GA_API_SECRET="your_ga_api_secret"
