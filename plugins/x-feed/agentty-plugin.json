{
  "id": "x-feed",
  "name": "X Feed",
  "version": "0.2.0",
  "publisher": "Agentty",
  "description": "Automate X from the in-app browser: follow accounts or keywords, save their posts with images and videos, like and reply at a safe pace, and post drafts in your own style. One tab per automation.",
  "icon": "x-twitter",
  "logo": "logo.png",
  "main": "main.mjs",
  "runtime": "node",
  "apiVersion": 3,
  "permissions": [
    "browser.control",
    "prompt.inject",
    "workspace.read"
  ],
  "browser": {
    "sites": [
      {
        "host": "x.com",
        "aliases": [
          "twitter.com"
        ],
        "home": "https://x.com/home",
        "signIn": "https://x.com/i/flow/login",
        "signedInCookie": "auth_token"
      }
    ]
  },
  "contributes": {
    "panel": {
      "title": "X Feed",
      "icon": "x-twitter",
      "surface": "sidebar",
      "mode": "workspace"
    }
  },
  "activationEvents": [
    "onStartup"
  ]
}
