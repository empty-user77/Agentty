{
  "id": "x-feed",
  "name": "X Feed",
  "version": "0.2.0",
  "publisher": "Agentty",
  "description": "Collect posts from X accounts, keep them refined with their images and videos, pick the best and turn them into drafts in your own style, ready to post.",
  "icon": "x-twitter",
  "main": "main.mjs",
  "runtime": "node",
  "apiVersion": 3,
  "permissions": [
    "browser.control",
    "prompt.inject",
    "workspace.read"
  ],
  "browser": {
    "sites": [
      {
        "host": "x.com",
        "aliases": [
          "twitter.com"
        ],
        "home": "https://x.com/home",
        "signIn": "https://x.com/i/flow/login",
        "signedInCookie": "auth_token"
      }
    ]
  },
  "contributes": {
    "panel": {
      "title": "X Feed",
      "icon": "x-twitter",
      "surface": "sidebar",
      "mode": "workspace"
    }
  },
  "activationEvents": [
    "onStartup"
  ]
}
