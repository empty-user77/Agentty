#!/bin/sh
# Blocks commits that add secrets (API keys, tokens, private keys). Do not bypass with --no-verify:
# replace the value with an obviously fake one, or move it to local config / Keychain.
root="$(git rev-parse --show-toplevel)"
python3 "$root/scripts/check-secrets.py" --staged || {
  echo "pre-commit: commit blocked — remove the secret(s) above and try again." >&2
  exit 1
}
