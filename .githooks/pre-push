#!/bin/sh
# Second line of defence: scans everything being pushed (catches commits made with --no-verify).
root="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    # New branch: everything not already on the remote.
    base="$(git rev-list --max-parents=0 "$local_sha" | tail -1)"
    range="$(git hash-object -t tree /dev/null)..$local_sha"
    [ -n "$(git for-each-ref --format='%(objectname)' refs/remotes)" ] && range="$(git merge-base "$local_sha" "$(git for-each-ref --format='%(objectname)' refs/remotes | head -1)" 2>/dev/null || echo "$base")..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  python3 "$root/scripts/check-secrets.py" --range "$range" || status=1
  python3 "$root/scripts/security-audit.py" --range "$range" || status=1
done
[ "$status" -ne 0 ] && echo "pre-push: push blocked — secrets or security-audit findings in the commits being pushed." >&2
exit $status
