# What never belongs in the repository. scripts/security-audit.py (SA01) and the PR guard
# (scripts/pr-guard.py) block most of these even when forced past this file with `git add -f`.

# -- Build output ---------------------------------------------------------------------------------
/target
/dist
*.profraw
*.profdata
perf.data*
*.dmg
*.pkg
*.msi
*.deb
*.rpm
*.AppImage
*.exe
*.dll
*.so
*.dylib
*.o
*.obj
*.a
*.lib

# Plugin modules are published through the Agentty Marketplace only, never from this repository.
*.wasm

# Archives: a release asset or a download, not source.
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

